# Python 字节码与本地虚拟环境
__pycache__/
*.py[cod]
.venv/
venv/
env/
.direnv/

# Python 检查、测试与覆盖率产物
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
/coverage.xml
/junit.xml

# Python 打包产物；依赖锁文件应提交
/build/
/dist/
*.egg-info/
.eggs/

# Java 样例及目标项目的构建缓存和产物
target/
.gradle/
.m2/
.rewrite-cache/
*.class
/tests/fixtures/**/build/
/examples/**/build/
# 保留 Maven / Gradle wrapper，包括 wrapper JAR

# 本地凭据；保留不含秘密的配置模板
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
/.secrets/

# 建议将运行时 checkpoint、目标项目副本、Diff 和报告统一放在此处
/.migraflow/
# LangGraph 本地开发服务生成的数据（使用该服务时）
.langgraph_api/
/logs/
/*.log
/tmp/
/temp/
# 不全局忽略 *.db、*.json、*.patch，保留测试数据和预期结果

# IDE 本地状态；共享的 .vscode 配置仍可提交
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources.local.xml
.history/
*.swp
*.swo
*~

# 操作系统生成文件
.DS_Store
Thumbs.db
Desktop.ini

# 应提交：AGENTS.md、docs/、.agents/skills/、pyproject.toml、锁文件、Recipe 配置和样例源码
