# Java 应用、样例及目标项目的构建缓存和产物
target/
build/
out/
/dist/
.gradle/
.m2/
.rewrite-cache/
*.class
*.hprof
# 保留 Maven / Gradle wrapper，包括 wrapper JAR
# 保留构建脚本、依赖锁文件与依赖校验配置

# 本地凭据；保留不含秘密的配置模板
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
/.secrets/

# MigraFlow 本地运行数据，如分析记录、日志、Diff 和报告；目标项目位于用户指定目录
/.migraflow/
/logs/
/*.log
/tmp/
/temp/
# 不全局忽略 *.db、*.json、*.patch，保留测试数据和预期结果

# IDE 本地状态；共享的 .vscode 配置仍可提交
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources.local.xml
.history/
*.swp
*.swo
*~

# 操作系统生成文件
.DS_Store
Thumbs.db
Desktop.ini

# 应提交：AGENTS.md、docs/、.agents/skills/、Maven / Gradle 配置、Recipe 配置和样例源码
